---
/**
 * One paper boat refolds through five personas: Researcher, Designer, Builder,
 * Reviewer, Tester. The hull says how heavy the model is (skiff, sloop,
 * freighter); the gear says the job. Each persona holds for about four
 * seconds, sails off to the left, and the next sails in from the right. Under
 * each, the provider's mark with the model and reasoning it runs on.
 * Twenty-second loop, transform and opacity only, gated by --motion-state.
 */
const personas = [
  { name: "Researcher", provider: "Antigravity", icon: "/harnesses/antigravity.png", model: "Gemini 3.8 Flash", reasoning: "medium" },
  { name: "Designer", provider: "Claude Code", icon: "/harnesses/claude-ai-icon.svg", model: "Fable 5.1", reasoning: "high" },
  { name: "Builder", provider: "Codex", icon: "/harnesses/openai_dark.svg", model: "Astra", reasoning: "high" },
  { name: "Reviewer", provider: "Grok", icon: "/harnesses/grok-dark.svg", model: "Grok 4.6", reasoning: "extra high" },
  { name: "Tester", provider: "OpenCode", icon: "/harnesses/opencode-dark.svg", model: "Qwen 3.5 Coder", reasoning: "high" },
];
---

<svg class="ps" viewBox="0 0 320 196" role="img" aria-label="One agent refolding through five personas: Researcher, Designer, Builder, Reviewer and Tester" data-motion>
  <defs>
    <g id="ps-skiff">
      <polygon class="ps-paper" points="6,34 58,34 50,44 14,44" />
      <polygon class="ps-shade" points="28,26 44,26 48,34 24,34" />
      <path class="ps-fold" d="M8 39h44" />
      <circle class="ps-eye" cx="24" cy="39.5" r="1.3" /><circle class="ps-eye" cx="40" cy="39.5" r="1.3" />
    </g>
    <g id="ps-freighter">
      <polygon class="ps-paper" points="0,30 64,30 58,46 6,46" />
      <rect class="ps-paper" x="44" y="16" width="12" height="14" />
      <rect x="46.5" y="19" width="3" height="3" fill="#dfe9ee" /><rect x="51" y="19" width="3" height="3" fill="#dfe9ee" />
      <rect class="ps-paper" x="58" y="21" width="4" height="9" />
      <path class="ps-fold" d="M4 38h56" />
      <circle class="ps-eye" cx="22" cy="39" r="1.4" /><circle class="ps-eye" cx="40" cy="39" r="1.4" />
      <path class="ps-line" d="M50 16v-9" />
      <polygon class="ps-pennant" points="50,6 62,9 50,12" />
    </g>
  </defs>

  <path class="ps-water" d="M0 130 Q 40 124 80 130 T 160 130 T 240 130 T 320 130" />

  <!-- Researcher: skiff, tall mast, crow's nest. -->
  <g class="ps-p ps-p1">
    <g transform="translate(96 30) scale(2)"><g class="bob" style="--bob-dur:5s">
      <use href="#ps-skiff" />
      <path class="ps-line" d="M36 26V0" />
      <polygon class="ps-shade" points="31,13 41,13 39.5,18 32.5,18" />
      <polygon class="ps-pennant" points="36,-1 48,2.5 36,6" />
    </g></g>
  </g>

  <!-- Designer: skiff, pennant at the masthead, a string of lights to the stern. -->
  <g class="ps-p ps-p2">
    <g transform="translate(96 30) scale(2)"><g class="bob" style="--bob-dur:5.4s">
      <use href="#ps-skiff" />
      <path class="ps-line" d="M40 26V12" />
      <polygon class="ps-pennant" points="40,11 52,14 40,17" />
      <path class="ps-string" d="M40 17 Q 50 30 58 33" />
      <circle cx="44.2" cy="21.6" r="1.7" fill="var(--msg-ask)" /><circle cx="48.4" cy="26.6" r="1.7" fill="var(--msg-receive)" /><circle cx="52.8" cy="30.2" r="1.7" fill="var(--msg-reply)" /><circle cx="56.6" cy="32.6" r="1.7" fill="var(--brass)" />
    </g></g>
  </g>

  <!-- Builder: freighter with a bow crane lifting a box. -->
  <g class="ps-p ps-p3">
    <g transform="translate(96 30) scale(2)"><g class="bob" style="--bob-dur:6s">
      <use href="#ps-freighter" />
      <rect class="ps-shade" x="7" y="26" width="7" height="4" />
      <path class="ps-line ps-line--thick" d="M10.5 26V8" />
      <path class="ps-line ps-line--boom" d="M10.5 10L30 4" />
      <path class="ps-line ps-line--brace" d="M10.5 16L22 6.5" />
      <path class="ps-line ps-line--thin" d="M30 4v9" />
      <path class="ps-line ps-line--thin" d="M28 13q2 3 4 0" />
      <rect class="ps-shade" x="25" y="16" width="10" height="7" />
    </g></g>
  </g>

  <!-- Reviewer: sloop with a bow spotlight. -->
  <g class="ps-p ps-p4">
    <g transform="translate(96 30) scale(2)"><g class="bob" style="--bob-dur:5.2s">
      <polygon class="ps-beam" points="9,20 -12,6 -12,30" />
      <use class="boat" href="#j5-boat" />
      <path class="ps-line" d="M12 30v-8" />
      <rect class="ps-brass" x="8.5" y="17" width="7" height="6" rx="1.5" />
      <path d="M8.5 18.5v3" stroke="#fbf7ee" stroke-width="1.4" />
    </g></g>
  </g>

  <!-- Tester: freighter, anchor forward on the hull, life ring aft. -->
  <g class="ps-p ps-p5">
    <g transform="translate(96 30) scale(2)"><g class="bob" style="--bob-dur:5.8s">
      <use href="#ps-freighter" />
      <path class="ps-line ps-line--chain" d="M10 30v6" />
      <circle cx="10" cy="36.6" r="1.2" fill="none" stroke="#12202f" stroke-width="0.9" />
      <path class="ps-line ps-line--thin" d="M10 37.8v5.6M7.6 39.3h4.8" />
      <path class="ps-line ps-line--thin" d="M6.8 41.2q3.2 3.6 6.4 0" />
      <circle cx="50" cy="38" r="3.6" fill="#fbf7ee" stroke="#c8442d" stroke-width="2.2" />
      <path d="M46.4 38h7.2M50 34.4v7.2" stroke="#fbf7ee" stroke-width="1" />
    </g></g>
  </g>

  {personas.map((p, i) => (
    <g class:list={["ps-label", `ps-l${i + 1}`]}>
      <text class="ps-name" x="160" y="148">{p.name}</text>
      <g class="ps-route" transform={`translate(${160 - (36 + Math.max(p.model.length, p.reasoning.length) * 5.4) / 2} 156)`}>
        <rect class="ps-tile" x="0" y="0" width="28" height="28" rx="7" />
        <image href={p.icon} x="4" y="4" width="20" height="20" />
        <text class="ps-model" x="36" y="12">{p.model}</text>
        <text class="ps-note" x="36" y="25">{p.reasoning}</text>
      </g>
    </g>
  ))}
</svg>

<style>
  .ps {
    display: block;
    width: 100%;
    max-width: 340px;
    height: auto;
    margin: 0 auto;
    overflow: hidden;
  }

  .ps-paper { fill: #fbf7ee; stroke: #12202f; stroke-width: 1.6; stroke-linejoin: round; }
  .ps-shade { fill: #e5ddc8; stroke: #12202f; stroke-width: 1.6; stroke-linejoin: round; }
  .ps-brass { fill: var(--brass); stroke: #12202f; stroke-width: 1.4; }
  .ps-fold { stroke: #12202f; stroke-opacity: 0.25; stroke-width: 1; fill: none; }
  .ps-eye { fill: #12202f; }
  .ps-line { stroke: #12202f; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; fill: none; }
  .ps-line--thick { stroke-width: 2.2; }
  .ps-line--boom { stroke-width: 1.8; }
  .ps-line--brace { stroke-width: 1; stroke-opacity: 0.6; }
  .ps-line--thin { stroke-width: 1; }
  .ps-line--chain { stroke-width: 1; stroke-dasharray: 1.5 1.5; }
  .ps-string { stroke: #12202f; stroke-width: 1; fill: none; }
  .ps-pennant { fill: var(--msg-reply); }
  .ps-beam { fill: var(--brass); fill-opacity: 0.22; }

  .ps-water {
    fill: none;
    stroke: var(--sea);
    stroke-opacity: 0.45;
    stroke-width: 1.2;
  }

  .ps-name {
    font-family: var(--font-display);
    font-size: 15px;
    text-anchor: middle;
    fill: var(--fg);
  }

  .ps-model {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--fg);
  }

  .ps-note {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--fg-dim);
  }

  /* White-on-transparent provider marks need a dark tile on chart paper. */
  .ps-tile {
    fill: var(--navy-900);
  }

  /* Each persona owns a fifth of the 20s loop: sails in from the right over
     the first second, holds, sails off to the left over the last second. The
     next one is already entering as this one leaves, like boats in a channel.
     The step back to the right edge is a step, not a tween: eased, the boat
     would cross the stage half-faded in the frame between the two keyframes. */
  .ps-p {
    opacity: 0;
    animation-duration: 20s;
    animation-timing-function: cubic-bezier(0.3, 0.6, 0.2, 1);
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .ps-p1 { animation-name: sail-1; }
  .ps-p2 { animation-name: sail-2; }
  .ps-p3 { animation-name: sail-3; }
  .ps-p4 { animation-name: sail-4; }
  .ps-p5 { animation-name: sail-5; }

  @keyframes sail-1 {
    0% { opacity: 1; transform: translateX(240px); }
    4.5%, 15.5% { opacity: 1; transform: translateX(0); }
    19.9% { opacity: 1; transform: translateX(-240px); animation-timing-function: step-end; }
    20%, 100% { opacity: 0; transform: translateX(240px); }
  }
  @keyframes sail-2 {
    0%, 14.9% { opacity: 0; transform: translateX(240px); }
    15% { opacity: 1; transform: translateX(240px); }
    24.5%, 35.5% { opacity: 1; transform: translateX(0); }
    39.9% { opacity: 1; transform: translateX(-240px); animation-timing-function: step-end; }
    40%, 100% { opacity: 0; transform: translateX(240px); }
  }
  @keyframes sail-3 {
    0%, 34.9% { opacity: 0; transform: translateX(240px); }
    35% { opacity: 1; transform: translateX(240px); }
    44.5%, 55.5% { opacity: 1; transform: translateX(0); }
    59.9% { opacity: 1; transform: translateX(-240px); animation-timing-function: step-end; }
    60%, 100% { opacity: 0; transform: translateX(240px); }
  }
  @keyframes sail-4 {
    0%, 54.9% { opacity: 0; transform: translateX(240px); }
    55% { opacity: 1; transform: translateX(240px); }
    64.5%, 75.5% { opacity: 1; transform: translateX(0); }
    79.9% { opacity: 1; transform: translateX(-240px); animation-timing-function: step-end; }
    80%, 100% { opacity: 0; transform: translateX(240px); }
  }
  @keyframes sail-5 {
    0%, 74.9% { opacity: 0; transform: translateX(240px); }
    75% { opacity: 1; transform: translateX(240px); }
    84.5%, 95.5% { opacity: 1; transform: translateX(0); }
    99.9% { opacity: 1; transform: translateX(-240px); animation-timing-function: step-end; }
    100% { opacity: 0; transform: translateX(240px); }
  }

  .ps-label {
    opacity: 0;
    animation-duration: 20s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .ps-l1 { animation-name: label-1; }
  .ps-l2 { animation-name: label-2; }
  .ps-l3 { animation-name: label-3; }
  .ps-l4 { animation-name: label-4; }
  .ps-l5 { animation-name: label-5; }

  @keyframes label-1 { 0%, 2% { opacity: 0; } 4%, 15% { opacity: 1; } 16.5%, 100% { opacity: 0; } }
  @keyframes label-2 { 0%, 22% { opacity: 0; } 24%, 35% { opacity: 1; } 36.5%, 100% { opacity: 0; } }
  @keyframes label-3 { 0%, 42% { opacity: 0; } 44%, 55% { opacity: 1; } 56.5%, 100% { opacity: 0; } }
  @keyframes label-4 { 0%, 62% { opacity: 0; } 64%, 75% { opacity: 1; } 76.5%, 100% { opacity: 0; } }
  @keyframes label-5 { 0%, 82% { opacity: 0; } 84%, 95% { opacity: 1; } 96.5%, 100% { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .ps-p, .ps-label { animation: none; }
    .ps-p3, .ps-l3 { opacity: 1; transform: none; }
  }
</style>
