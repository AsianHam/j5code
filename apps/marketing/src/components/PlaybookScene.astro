---
/**
 * The channel runs off-canvas at both ends so the convoy enters and leaves
 * whole. Seats trail the Captain by positive delays, which shift their phase
 * for good on an infinite animation. The Playbooks card's step card shares
 * this 24s clock, so keep their keyframes in step.
 */
---

<svg class="pb" viewBox="0 18 520 122" role="img" aria-label="A Captain leading three agents along a route of numbered buoys" data-motion>
  <path class="pb-channel" d="M-110 118 C 0 60, 110 150, 210 100 S 420 40, 520 96 S 600 120, 630 110" />

  <g class="pb-buoy" style="offset-distance: 24%"><circle r="7" /><text y="2.6">1</text></g>
  <g class="pb-buoy" style="offset-distance: 37%"><circle r="7" /><text y="2.6">2</text></g>
  <g class="pb-buoy" style="offset-distance: 50%"><circle r="7" /><text y="2.6">3</text></g>
  <g class="pb-buoy" style="offset-distance: 63%"><circle r="7" /><text y="2.6">4</text></g>
  <g class="pb-buoy" style="offset-distance: 76%"><circle r="7" /><text y="2.6">5</text></g>

  <g class="pb-boat pb-boat--captain"><g transform="translate(-35 -44) scale(1.1)"><use class="boat pb-flag pb-flag--captain" href="#j5-captain" /></g></g>
  <g class="pb-boat pb-boat--s1"><g transform="translate(-27 -34) scale(0.85)"><use class="boat pb-flag pb-flag--s1" href="#j5-boat" /></g></g>
  <g class="pb-boat pb-boat--s2"><g transform="translate(-27 -34) scale(0.85)"><use class="boat pb-flag pb-flag--s2" href="#j5-boat" /></g></g>
  <g class="pb-boat pb-boat--s3"><g transform="translate(-27 -34) scale(0.85)"><use class="boat pb-flag pb-flag--s3" href="#j5-boat" /></g></g>
</svg>

<style>
  .pb {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .pb-channel {
    fill: none;
    stroke: var(--sea, #3b8fae);
    stroke-opacity: 0.6;
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
  }

  .pb-buoy {
    offset-path: path("M-110 118 C 0 60, 110 150, 210 100 S 420 40, 520 96 S 600 120, 630 110");
    offset-rotate: 0deg;
  }

  .pb-buoy circle {
    fill: var(--brass, #c9a24d);
    stroke: var(--ink, #12202f);
    stroke-width: 1;
  }

  .pb-buoy text {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 600;
    text-anchor: middle;
    fill: #12202f;
  }

  .pb-boat {
    offset-path: path("M-110 118 C 0 60, 110 150, 210 100 S 420 40, 520 96 S 600 120, 630 110");
    offset-rotate: 0deg;
    opacity: 0;
    animation: pb-sail 24s linear infinite;
    animation-play-state: var(--motion-state, paused);
  }

  /* The Captain leads on the card's clock; each seat trails by 1.8s. */
  .pb-boat--captain { animation-delay: 0s; }
  .pb-boat--s1 { animation-delay: 1.8s; }
  .pb-boat--s2 { animation-delay: 3.6s; }
  .pb-boat--s3 { animation-delay: 5.4s; }

  @keyframes pb-sail {
    from { offset-distance: 0%; opacity: 1; }
    to { offset-distance: 100%; opacity: 1; }
  }

  /* Flags share each boat's 24s clock and delay, so a color change lands as
     the boat passes a buoy. Buoys sit at 24, 37, 50, 63 and 76 percent. */
  .pb-flag {
    --pennant: var(--msg-reply);
    animation-duration: 24s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-play-state: var(--motion-state, paused);
  }
  .pb-flag--captain { animation-name: pb-flag-captain; animation-delay: 0s; }
  .pb-flag--s1 { animation-name: pb-flag-seat; animation-delay: 1.8s; }
  .pb-flag--s2 { animation-name: pb-flag-seat; animation-delay: 3.6s; }
  .pb-flag--s3 { animation-name: pb-flag-seat; animation-delay: 5.4s; }

  @keyframes pb-flag-captain {
    0%, 37%, 51%, 100% { --pennant: var(--msg-reply); }
    38%, 50% { --pennant: var(--msg-ask); }
  }
  @keyframes pb-flag-seat {
    0%, 50%, 64%, 100% { --pennant: var(--msg-reply); }
    51%, 63% { --pennant: var(--msg-receive); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pb-boat, .pb-flag { animation: none; opacity: 1; }
    .pb-boat--captain { offset-distance: 46%; }
    .pb-boat--s1 { offset-distance: 39%; }
    .pb-boat--s2 { offset-distance: 32%; }
    .pb-boat--s3 { offset-distance: 25%; }
  }
</style>
