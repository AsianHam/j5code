---
/**
 * The paper-boat sprite. Rendered once per page; every Boat renders a <use>
 * against these ids. Colors come from CSS custom properties on the using <svg>
 * (--ink, --hull, --sail-l, --sail-r, --pennant, --pennant-fill), which inherit
 * into the use shadow tree, so one sprite serves every tone and status.
 */
---

<svg class="j5-sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <g id="j5-boat">
      <polygon points="14,30 32,8 32,30" fill="var(--sail-l)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
      <polygon points="32,8 32,30 50,30" fill="var(--sail-r)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
      <polygon points="4,30 60,30 50,44 14,44" fill="var(--hull)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M8 35h48" stroke="var(--ink)" stroke-opacity="0.25" stroke-width="1" />
      <circle cx="24" cy="37" r="1.4" fill="#12202f" />
      <circle cx="40" cy="37" r="1.4" fill="#12202f" />
      <path d="M32 8v-7" stroke="var(--ink)" stroke-width="1.4" />
      <polygon points="32,0 45,3.5 32,7" fill="var(--pennant-fill)" stroke="var(--pennant)" stroke-width="1.4" stroke-linejoin="round" />
    </g>
    <g id="j5-captain">
      <polygon points="14,30 32,4 32,30" fill="var(--sail-l)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
      <polygon points="32,4 32,30 50,30" fill="var(--sail-r)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
      <polygon points="2,30 62,30 51,46 13,46" fill="var(--hull)" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
      <polygon points="4,33 60,33 58.6,35.5 5.4,35.5" fill="#c9a24d" />
      <path d="M9 40h46" stroke="var(--ink)" stroke-opacity="0.25" stroke-width="1" />
      <circle cx="24" cy="40.5" r="1.5" fill="#12202f" />
      <circle cx="40" cy="40.5" r="1.5" fill="#12202f" />
      <path d="M32 19l1.6 3.3 3.6.5-2.6 2.5.6 3.6-3.2-1.7-3.2 1.7.6-3.6-2.6-2.5 3.6-.5z" fill="#c9a24d" />
      <path d="M32 4v-7" stroke="var(--ink)" stroke-width="1.4" />
      <polygon points="32,-4 46,-1.5 41,1 46,3.5 32,3" fill="#c9a24d" />
    </g>
    <!-- A person: a sailor in a sea-blue jersey, origin at the feet, with a signal flag in hand
         whose tip is at (12,-34). The flag takes the message colors as a boat's pennant does.
         The arm is paper and the pole brass, each over an ink edge, so they read on chart paper and on navy. -->
    <g id="j5-sailor">
      <polygon points="-7,0 7,0 5,-16 -5,-16" fill="#3b8fae" stroke="var(--ink)" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M-5.6 -11.5h11.2M-6 -7.5h12M-6.4 -3.5h12.8" stroke="var(--hull)" stroke-width="1.3" />
      <circle cx="0" cy="-21.5" r="5.5" fill="var(--hull)" stroke="var(--ink)" stroke-width="1.6" />
      <circle cx="-2" cy="-22" r="0.9" fill="#12202f" /><circle cx="2" cy="-22" r="0.9" fill="#12202f" />
      <polygon points="-6,-25.5 6,-25.5 5,-29 -5,-29" fill="var(--sail-l)" stroke="var(--ink)" stroke-width="1.4" stroke-linejoin="round" />
      <circle cx="0" cy="-30" r="1.3" fill="#c8442d" />
      <path d="M5 -13L12 -20M12 -20v-14" fill="none" stroke="var(--ink)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M5 -13L12 -20" stroke="var(--hull)" stroke-width="1.6" stroke-linecap="round" />
      <path d="M12 -20v-14" stroke="#c9a24d" stroke-width="1.6" stroke-linecap="round" />
      <polygon points="12,-34 23,-31 12,-28" fill="var(--pennant-fill)" stroke="var(--pennant)" stroke-width="1.4" stroke-linejoin="round" />
    </g>
    <!-- J5 polling for its device: a flat river barge with no mast and no flag, so it never
         reads as an agent. Messages ride on the cargo hold at local y 4.5, slots x 20, 32, 44. -->
    <g id="j5-barge">
      <rect x="71" y="-2" width="17" height="16" rx="1.5" fill="#ebe3d1" stroke="#12202f" stroke-width="1.6" />
      <rect x="74.5" y="2" width="10" height="5" rx="1" fill="#173a62" />
      <path d="M79.5 -2v-3" stroke="#12202f" stroke-width="1.6" stroke-linecap="round" />
      <rect x="10" y="9" width="54" height="5" rx="1" fill="#4a5867" stroke="#12202f" stroke-width="1.4" />
      <polygon points="0,14 96,14 90,28 6,28" fill="#173a62" stroke="#12202f" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M3 19.5h90" stroke="#c9a24d" stroke-width="2" />
      <circle cx="16" cy="24" r="1.3" fill="#dfe9ee" />
      <circle cx="80" cy="24" r="1.3" fill="#dfe9ee" />
    </g>
  </defs>
</svg>

<style>
  .j5-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
