---
import dmSansLatinUrl from "../assets/fonts/dm-sans-latin.woff2?url";
import "../styles/fonts.css";
import BoatSprite from "../components/BoatSprite.astro";
import { GITHUB_REPOSITORY_URL, LICENSE_URL, T3_SITE_URL, INSTALL_DOCS_URL, GITHUB_RELEASES_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "J5 Code: T3 Code with a fleet layer",
  description =
    "J5 Code is T3 Code with a fleet layer: Crews and agent-to-agent messaging with a ledger, so one person can run many long-lived coding agents.",
} = Astro.props;

// Link unfurlers want a 1200x630 image at an absolute URL. The card is a
// pre-rendered PNG in public/ so the build needs no fonts.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/og.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="J5 Code" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="J5 Code: run a fleet, not a chat. Paper boats with status pennants on a navy chart." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="preload" href={dmSansLatinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <BoatSprite />
    <div class="page">
      <nav class="nav">
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="J5 Code home">
            <span class="nav-brand-name">J5 Code</span>
          </a>
          <div class="nav-links">
            <a href="/download">Download</a>
            <a class="nav-github" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.2c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <img src="/j5-app-icon.svg" alt="" width="20" height="20" loading="lazy" decoding="async" />
            <span>
              J5 Code is a tracking fork of <a href={T3_SITE_URL} target="_blank" rel="noopener noreferrer">T3 Code</a>. <a href={LICENSE_URL} target="_blank" rel="noopener noreferrer">MIT licensed</a>.
            </span>
          </div>
          <div class="footer-links">
            <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener noreferrer">Releases</a>
            <a href={INSTALL_DOCS_URL} target="_blank" rel="noopener noreferrer">Install guide</a>
            <a href="/download">Download</a>
            <a href={T3_SITE_URL} target="_blank" rel="noopener noreferrer">T3 Code</a>
            <a href="/privacy-policy">Privacy</a>
            <a href="/legal">Legal</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const nav = document.querySelector(".nav");
      const onScroll = () => {
        if (!nav) return;
        nav.classList.toggle("is-scrolled", window.scrollY > 12);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  /*
   * Two palettes share one page. The nautical palette is the default and the
   * Foundation section flips to T3 Code's own tokens with [data-theme="t3"], so
   * the borrowed hull looks like where it came from.
   */
  :root {
    --navy-950: #061220;
    --navy-900: #0a1c30;
    --navy-800: #102a47;
    --navy-700: #173a62;
    --canvas: #f4efe4;
    --canvas-2: #ebe3d1;
    --canvas-line: rgba(18, 32, 47, 0.14);
    --ink: #12202f;
    --ink-muted: #4a5867;
    --ink-dim: #5f6a76; /* 4.8:1 on chart paper */
    --brass: #c9a24d;
    --brass-deep: #a67f2a;
    --brass-soft: rgba(201, 162, 77, 0.18);
    --signal: #c8442d;
    --sea: #3b8fae;
    --foam: #dfe9ee;
    --foam-muted: rgba(223, 233, 238, 0.72);
    --foam-dim: rgba(223, 233, 238, 0.6); /* 5.0:1 on the lightest navy */
    --line: rgba(223, 233, 238, 0.14);
    --line-strong: rgba(223, 233, 238, 0.28);
    /* Message colors, the same on every scene: an agent sending, receiving, replying. */
    --msg-ask: #e08a3c;
    --msg-receive: #3b8fae;
    --msg-reply: #6fcf9a;

    --bg: var(--navy-950);
    --fg: var(--foam);
    --fg-muted: var(--foam-muted);
    --fg-dim: var(--foam-dim);
    --border: var(--line);
    --border-strong: var(--line-strong);
    --accent: var(--brass);

    --font-display: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino,
      "URW Palladio L", Georgia, "Times New Roman", serif;
    --font-sans: "DM Sans", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 16px;
  }

  [data-theme="t3"] {
    --bg: #09090b;
    --bg-elev: #0c0c0e;
    --fg: #fafafa;
    --fg-muted: #a1a1aa;
    --fg-dim: #85858e; /* 5.2:1 on T3 cards */
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.14);
    --accent: oklch(0.68 0.17 250);
    --accent-dim: oklch(0.68 0.17 250 / 0.15);
    --ok: oklch(0.72 0.16 150);
    --warn: oklch(0.76 0.15 75);
    --font-display: var(--font-sans);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }


  .display {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 500;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 8px;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--brass);
    color: var(--navy-950);
    font-weight: 600;
  }

  .btn-primary:hover {
    transform: translateY(-1px);
    background: #d8b463;
  }

  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-ghost {
    color: var(--fg-muted);
    border: 1px solid var(--border);
    background: transparent;
  }

  .btn-ghost:hover {
    color: var(--fg);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.03);
  }

  .btn-lg {
    padding: 14px 22px;
    font-size: 15px;
    border-radius: 10px;
  }

  .btn-mono {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: -0.01em;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Page-load sequence: [data-rise] plays once with delay --d. Nothing loops. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  [data-rise] {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-rise] {
      animation: none;
    }
  }

  /* Registered so animated flag colors fade instead of flipping where supported. */
  @property --pennant {
    syntax: "<color>";
    inherits: true;
    initial-value: #8fa0ad;
  }

  /*
   * Boats bob on their own phase. Continuous, so every .bob sits inside a
   * [data-motion] scene whose --motion-state the controller in lib/motion.ts
   * flips to running only while the scene is on screen.
   */
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-1.5deg);
    }
    50% {
      transform: translateY(-3px) rotate(1.5deg);
    }
  }
  .bob {
    animation: bob var(--bob-dur, 5s) ease-in-out var(--bob-delay, 0s) infinite;
    animation-play-state: var(--motion-state, paused);
    transform-box: fill-box;
    transform-origin: 50% 85%;
  }
  @media (prefers-reduced-motion: reduce) {
    .bob {
      animation: none;
    }
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: color-mix(in srgb, var(--navy-950) 78%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .nav.is-scrolled {
    border-bottom-color: var(--line);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--foam);
  }


  .nav-brand-name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .nav-links {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    font-size: 13.5px;
    color: var(--foam-muted);
  }

  .nav-links a {
    transition: color 0.18s ease;
  }

  .nav-links a:hover {
    color: var(--foam);
  }

  .nav-github {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(223, 233, 238, 0.03);
  }

  .nav-github:hover {
    border-color: var(--line-strong);
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding: 40px 0 32px;
    background: var(--navy-950);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--foam-dim);
  }

  .footer-brand img {
    width: 20px;
    height: 20px;
    border-radius: 5px;
  }

  .footer-brand a {
    color: var(--foam-muted);
    text-decoration: underline;
    text-decoration-color: rgba(223, 233, 238, 0.3);
    text-underline-offset: 3px;
  }

  .footer-brand a:hover {
    color: var(--foam);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--foam-dim);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--foam);
  }

  @media (max-width: 820px) {
    .nav-inner,
    .footer-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .nav-links a:not(.nav-github) {
      display: none;
    }

    .footer {
      padding-bottom: max(32px, env(safe-area-inset-bottom));
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }

    .footer-links {
      justify-content: flex-start;
    }
  }
</style>
