---
import Layout from "../../layouts/Layout.astro";
import { T3_SITE_URL } from "../../lib/site";

interface Item {
  title: string;
  body: string;
}

interface Group {
  heading: string;
  intro: string;
  items: ReadonlyArray<Item>;
}

// Everything J5 Code takes in from upstream T3 Code 0.1.3. Mobile items wait for the rebuilt J5
// mobile app, and things J5 turned off are left out.
const groups: ReadonlyArray<Group> = [
  {
    heading: "Search",
    intro: "Cmd+K was rebuilt around one ranking, and it now reads what your threads say.",
    items: [
      {
        title: "Search inside your messages",
        body: "An In messages section finds text inside messages, not just thread titles.",
      },
      {
        title: "Better ranking",
        body: "Results are ordered by how well they match and how recently you used them. Subagent threads stay out of the way.",
      },
      {
        title: "Recent picks follow you",
        body: "The threads you opened from Cmd+K are remembered across your devices.",
      },
    ],
  },
  {
    heading: "Threads and the composer",
    intro: "Fewer things stand between you and the next message.",
    items: [
      {
        title: "Approvals don't block the composer",
        body: "Sending a message while an agent waits for approval declines the request and steers your message in. Typed feedback on a Claude approval goes to the subagent that asked.",
      },
      {
        title: "Approval cards say why",
        body: "In Full access, a card from Claude explains why it stopped to ask.",
      },
      {
        title: "Quieter timelines",
        body: "Messages from other agents and automation prompts fold to one line. Click one to read it.",
      },
      {
        title: "A Waiting status",
        body: "A thread that is only blocked on another thread shows Waiting instead of looking stuck.",
      },
      {
        title: "Snooze and settle behave",
        body: "Snooze survives automatic wake-ups, settling clears a snooze, and empty threads settle themselves. Cmd+Z undoes settle, snooze and archive even while the composer has focus.",
      },
      {
        title: "Thread title instructions",
        body: "Tell J5 Code how to name new threads in a project, under Settings → General → Thread title instructions.",
      },
      {
        title: "Stop clears what it should",
        body: "Stop on a stuck delegated task always clears it, and a delegated task finishes once its leftover background work settles.",
      },
      {
        title: "Small things",
        body: "Cmd+B toggles the sidebar. Links to threads show as chips with the project's icon. Right-to-left text displays correctly.",
      },
    ],
  },
  {
    heading: "Claude and other providers",
    intro: "Long Claude threads cost less to come back to, and every provider fails more clearly.",
    items: [
      {
        title: "Compact idle threads",
        body: "Choose when an idle Claude thread over 200,000 tokens is compacted, under Settings → General → Compact idle threads: When you return (the default, as before), Before the cache expires (beta, sends a visible /compact turn), or Never. Each Claude provider can override it.",
      },
      {
        title: "Claude may stop and ask in Full access",
        body: "A question Claude raises in Full access now reaches you instead of being answered for it, so an unattended run can wait on you. Plan mode asks before it writes, even in Full access.",
      },
      {
        title: "Cleaner subagent handoffs",
        body: "A subagent's result arrives as one queued message, and a Codex parent resumes once its native children finish.",
      },
      {
        title: "Fewer stray processes",
        body: "The Claude CLI exits with the server that started it, and Cursor connection errors after a reply has started fail the turn instead of leaving it hanging.",
      },
    ],
  },
  {
    heading: "Pull requests",
    intro: "More of a pull request at a glance.",
    items: [
      {
        title: "What kind of code changed",
        body: "Change stats split into code, tests, mocks, generated files and docs.",
      },
      {
        title: "Filters search the host",
        body: "Label and author filters find matches on the host, not only in what is loaded.",
      },
      {
        title: "Each host's own words",
        body: "Hosts that say merge request are shown that way. GitCafe pull requests show reviewers and labels.",
      },
    ],
  },
  {
    heading: "Machines and connections",
    intro: "Running J5 Code on more than one machine takes fewer steps.",
    items: [
      {
        title: "Add a project to another machine",
        body: "From Run on, add a project to another machine and choose which ignored files, such as .env, come along.",
      },
      {
        title: "Clearer connection problems",
        body: "Reconnecting to a frozen host explains what happened, j5 connect status checks that the host can be reached, and T3 Connect failures name the fix.",
      },
      {
        title: "Service settings that stick",
        body: "Put environment variables for the background service in ~/.j5code/service.env. They survive reinstalls and updates.",
      },
      {
        title: "Tidier upgrades",
        body: "Updates prune old runtimes, j5 doctor can delete the database kept from before the V2 upgrade, and one Database notice covers all your machines.",
      },
    ],
  },
  {
    heading: "Scheduled tasks and webhooks",
    intro: "Webhook tasks run when they should, and only once.",
    items: [
      {
        title: "Event filters",
        body: "A webhook task can filter on event fields, including any item of a list.",
      },
      {
        title: "No duplicate runs",
        body: "Replayed deliveries are dropped, and bursts can be coalesced into one run.",
      },
      {
        title: "Safer prompts",
        body: "Values from a webhook reach the agent marked as untrusted input.",
      },
    ],
  },
  {
    heading: "Reading and usage",
    intro: "Smaller improvements across the app.",
    items: [
      {
        title: "Rendering",
        body: "Mermaid diagrams use a much smaller renderer, and LaTeX math can be turned on.",
      },
      {
        title: "Usage",
        body: "Usage shows even-pace marks, includes Muse Code history, and gives ChatGPT Business members a request to copy to their admin when they reach a limit.",
      },
      {
        title: "Diagnostics",
        body: "OpenTelemetry export adds run and resource metrics, and the browser panel lets you pick a search engine.",
      },
      {
        title: "Accessibility",
        body: "Screen readers announce which thread a shortcut switched to and which background thread finished.",
      },
      {
        title: "Settings",
        body: "Saving settings no longer undoes edits made to the settings file outside the app.",
      },
      {
        title: "Fewer interruptions",
        body: "The provider Update available toast no longer appears on launch, and the startup pairing link is printed only to the terminal's standard output.",
      },
    ],
  },
  {
    heading: "For your agents",
    intro: "The tools agents call stay the same, with better answers.",
    items: [
      {
        title: "Shorter model lists",
        body: "orchestrator_capabilities returns a short default list of models and lets an agent search for others.",
      },
      {
        title: "Delegation keeps its settings",
        body: "delegate_task merges model options by id and reports the options a child runs with, and a wait returns early when the child needs an approval.",
      },
      {
        title: "Richer reads",
        body: "Thread reads say which thread sent each message and list linked pull requests. Cancelling a task also cancels its queued turn.",
      },
    ],
  },
  {
    heading: "Speed and security",
    intro: "Much of this release makes J5 Code faster and safer without changing how it looks.",
    items: [
      {
        title: "Faster while agents stream",
        body: "Every web screen compiles with the React Compiler, and around two hundred performance fixes cut rendering while agents stream and you type. Database reads no longer wait behind writes.",
      },
      {
        title: "Security fixes",
        body: "Windows network paths in markdown can no longer leak credentials, file saves don't follow links out of the workspace, and the desktop app moves to Electron 44.9.3.",
      },
    ],
  },
];
---

<Layout
  title="What's new in 0.1.3 — J5 Code"
  description="Search inside your messages, approvals that don't block the composer, idle compaction for Claude, and everything else J5 Code picks up from upstream T3 Code 0.1.3."
>
  <div class="whats-new">
    <section class="hero">
      <div class="container hero-inner">
        <p class="eyebrow">What's new · from T3 Code 0.1.3</p>
        <h1 class="display">Search inside your messages, and much more.</h1>
        <p class="lead">
          J5 Code tracks <a href={T3_SITE_URL} target="_blank" rel="noopener noreferrer">T3 Code</a>,
          and this update brings in upstream's 0.1.3 release. Here is everything it changes for you.
        </p>
      </div>
    </section>

    {
      groups.map((group, index) => (
        <section class={index % 2 === 0 ? "paper" : "deep"}>
          <div class="container">
            <div class="section-head">
              <h2 class="display">{group.heading}</h2>
              <p>{group.intro}</p>
            </div>
            <ul class="items">
              {group.items.map((item) => (
                <li>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  /* Sections alternate chart paper and open water, as the peering page does. */
  section {
    position: relative;
    padding: 80px 0;
    border-top: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
  }

  .paper {
    --bg: var(--canvas);
    --fg: var(--ink);
    --fg-muted: var(--ink-muted);
    --fg-dim: var(--ink-dim);
    --border: var(--canvas-line);
    color-scheme: light;
    background-image:
      linear-gradient(to right, rgba(18, 32, 47, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(18, 32, 47, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  .deep {
    background: linear-gradient(180deg, var(--navy-950) 0%, var(--navy-900) 55%, #1a2f4a 100%);
  }

  .hero {
    padding: 104px 0 96px;
    border-top: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% -10%, rgba(59, 143, 174, 0.22), transparent 70%),
      linear-gradient(180deg, var(--navy-900) 0%, var(--navy-950) 70%);
  }

  .hero-inner {
    text-align: center;
  }

  .eyebrow {
    font: 600 11px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(34px, 4.6vw, 60px);
    max-width: 28ch;
    margin: 0 auto 24px;
    text-wrap: balance;
  }

  .lead {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    max-width: 640px;
    margin: 0 auto;
  }

  .lead a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: 40px;
  }

  .section-head h2 {
    font-size: clamp(28px, 3.2vw, 40px);
    line-height: 1.08;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.55;
    max-width: 640px;
    margin-top: 14px;
  }

  .items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 56px;
  }

  .items li {
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  h3 {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin-bottom: 6px;
  }

  .items p {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    section {
      padding: 64px 0;
    }

    .hero {
      padding: 72px 0 64px;
    }

    .items {
      grid-template-columns: 1fr;
    }
  }
</style>
