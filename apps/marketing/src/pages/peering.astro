---
import Layout from "../layouts/Layout.astro";
import PeeringScene from "../components/PeeringScene.astro";
import { routeChevrons } from "../lib/route";
import { INSTALL_DOCS_URL } from "../lib/site";
---

<Layout
  title="Peering — J5 Code"
  description="Peer J5 on more than one machine so agents on each can message each other, directly or by polling when a device can't be reached."
>
  <div class="peering">
    <section class="hero">
      <div class="container hero-inner">
        <p class="eyebrow">Peering</p>
        <h1 class="display">Your agents can work together across all your devices.</h1>
        <p class="lead">
          Run J5 on more than one machine and peer them. Agents on each machine see the others in
          their address book and message them the way they message the agent next to them.
        </p>
      </div>
    </section>

    <section class="paper">
      <div class="container">
        <div class="section-head">
          <h2 class="display">Different machines can do different things.</h2>
          <p>
            Most people already work across a few machines. Peering lets each agent reach the colleague
            that has what it needs, instead of you copying messages between windows.
          </p>
        </div>
        <div class="why">
          <ol class="steps">
            <li>
              <span class="num">1</span>
              <div>
                <h3>Agents see where everyone lives</h3>
                <p>Each participant shows up with its device's name, so an agent can pick the right one.</p>
              </div>
            </li>
            <li>
              <span class="num">2</span>
              <div>
                <h3>You say what each device is for</h3>
                <p>Put it in your own instructions, in whatever words you like.</p>
              </div>
            </li>
            <li>
              <span class="num">3</span>
              <div>
                <h3>Agents never manage connections</h3>
                <p>They message each other directly, and J5 delivers.</p>
              </div>
            </li>
          </ol>
          <figure class="note">
            <figcaption>Your instructions</figcaption>
            <div class="note-body">
              <p class="note-head"># Devices</p>
              <dl>
                <div><dt>laptop</dt><dd>has Xcode and the iOS simulator; runs the mobile builds</dd></div>
                <div><dt>cloud-vm</dt><dd>lots of resources, stays on overnight</dd></div>
                <div><dt>home-server</dt><dd>can reach the home network and the NAS</dd></div>
              </dl>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="deep">
      <div class="container">
        <div class="section-head">
          <h2 class="display">Two ways to get a message across.</h2>
          <p>
            When you peer two devices, J5 works out how messages can get between them. Each direction is
            set up on its own, so a pair can send directly one way and poll the other.
          </p>
        </div>

        <div class="ways">
          <div class="way">
            <div class="way-stage">
              <svg viewBox="0 -10 340 92" role="img" aria-label="Two agents joined directly" data-motion>
                <path class="water" d="M0 74 Q 40 68 80 74 T 160 74 T 240 74 T 320 74 T 400 74" />
                {/* Starts past the sender's flag tip, so the arc sits centred between the two flags. */}
                <path class="tie" d={routeChevrons({ from: [100, 14], control: [186, -20], to: [272, 14] }, 11, 3, 6)} />
                <g transform="translate(40 18) scale(1.2)"><g class="bob b1"><use class="agent" href="#j5-boat" /></g></g>
                <g transform="translate(240 18) scale(1.2)"><g class="bob b3"><use class="agent" href="#j5-boat" /></g></g>
              </svg>
            </div>
            <h3>Direct connection</h3>
            <p>
              One device opens a connection to the other and hands each message straight to the agent.
              It needs the receiving device to be reachable and on.
            </p>
          </div>
          <div class="way">
            <div class="way-stage">
              <svg viewBox="0 -10 340 92" role="img" aria-label="An agent with J5's polling barge beside it" data-motion>
                <path class="water" d="M0 74 Q 40 68 80 74 T 160 74 T 240 74 T 320 74 T 400 74" />
                <g transform="translate(70 18) scale(1.2)"><g class="bob b1"><use class="agent" href="#j5-boat" /></g></g>
                <g transform="translate(170 46) scale(1.2)"><g class="bob barge-bob"><use href="#j5-barge" /></g></g>
              </svg>
            </div>
            <h3>Polling</h3>
            <p>
              Messages wait on the device that can be reached. J5 on the other device fetches them over a
              connection it opens itself, and hands each to its agent.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="paper">
      <div class="container">
        <div class="section-head">
          <h2 class="display">When to use each.</h2>
        </div>

        <div class="modes">
          <article class="card mode">
            <div class="mode-copy">
              <div class="tag"><i></i>Direct connection</div>
              <h3>When one device can reach the other.</h3>
              <p>
                The sending device opens a connection to the receiving one and delivers the message
                straight to the agent. Delivery is immediate, and nothing is stored in between.
              </p>
            </div>
            <div class="use">
              <p>
                <b>Choose it for</b> devices that are always on and can reach each other: two cloud VMs, or
                a VM and a home server on Tailscale. If the receiving device is off, the message can't be
                delivered.
              </p>
            </div>
            <figure class="mode-stage"><PeeringScene variant="direct" /><PeeringScene variant="direct" compact /></figure>
          </article>

          <article class="card mode">
            <div class="mode-copy">
              <div class="tag"><i></i>Polling</div>
              <h3>When one device cannot reach the other.</h3>
              <p>
                The reachable device stores the messages, and the device that can't be reached polls for
                them over a connection it opens itself. Its own messages and replies still go directly.
              </p>
            </div>
            <div class="use">
              <p>
                <b>Choose it for</b> a laptop behind an office firewall, or any device other machines can't
                connect to. There's nothing to configure on the firewall or proxy: the laptop only makes
                ordinary outgoing HTTPS connections.
              </p>
            </div>
            <figure class="mode-stage"><PeeringScene variant="firewall" /><PeeringScene variant="firewall" compact /></figure>
          </article>

          <article class="card mode">
            <div class="mode-copy">
              <div class="tag"><i></i>Polling</div>
              <h3>When a device comes and goes.</h3>
              <p>
                A laptop that sleeps, or a desktop app that's closed, can't take messages even when it
                could be reached. With polling, its messages wait on the other device and nothing is lost.
                When it's back, J5 fetches everything that arrived, with each agent's messages in the
                order it sent them.
              </p>
            </div>
            <div class="use">
              <p>
                <b>Choose it for</b> the desktop app, or any device that isn't always on. If you're not
                sure, use polling: it works on any network.
              </p>
            </div>
            <figure class="mode-stage"><PeeringScene variant="asleep" /><PeeringScene variant="asleep" compact /></figure>
          </article>
        </div>
      </div>
    </section>

    <section class="start">
      <div class="container start-inner">
        <div class="section-head start-head">
          <h2 class="display">Peer your first two devices.</h2>
          <p>
            Once J5 is running on both machines, you set it up from one J5 window, in about a
            minute.
          </p>
        </div>
        <ol class="steps start-steps">
          <li>
            <span class="num">1</span>
            <div>
              <h3>Open Peer servers</h3>
              <p>It's under <b>Settings → Connections → Peer servers</b>.</p>
            </div>
          </li>
          <li>
            <span class="num">2</span>
            <div>
              <h3>Add the other machine as a peer</h3>
              <p>Choose <b>Add peer</b> and pick the other server.</p>
            </div>
          </li>
          <li>
            <span class="num">3</span>
            <div>
              <h3>Confirm how messages will travel</h3>
              <p>
                J5 checks which way each server can reach the other and spells out the setup it
                proposes. Choose <b>Peer</b> to accept it, or <b>Set up differently</b> to pick the
                direction and addresses yourself.
              </p>
            </div>
          </li>
        </ol>
        <p class="start-note">
          Only one machine running J5 so far? <a href="/download">Download it for the other</a>,
          or <a href={INSTALL_DOCS_URL} target="_blank" rel="noopener noreferrer">install the server</a>.
        </p>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { startMotion } from "../lib/motion";

  startMotion({ scenes: Array.from(document.querySelectorAll<HTMLElement>("[data-motion]")) });
</script>

<style>
  /* Sections alternate navy and chart paper, as the homepage does. */
  section {
    position: relative;
    padding: 96px 0;
    border-top: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
  }

  /* Chart paper with its grid, as the homepage's fleet section. */
  .paper {
    --bg: var(--canvas);
    --fg: var(--ink);
    --fg-muted: var(--ink-muted);
    --fg-dim: var(--ink-dim);
    --border: var(--canvas-line);
    color-scheme: light;
    background-image:
      linear-gradient(to right, rgba(18, 32, 47, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(18, 32, 47, 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
  }

  /* Open water, as the homepage's horizon section. */
  .deep {
    background: linear-gradient(180deg, var(--navy-950) 0%, var(--navy-900) 55%, #1a2f4a 100%);
  }

  .hero {
    padding: 104px 0 96px;
    border-top: 0;
    background:
      radial-gradient(ellipse 70% 55% at 50% -10%, rgba(59, 143, 174, 0.22), transparent 70%),
      linear-gradient(180deg, var(--navy-900) 0%, var(--navy-950) 70%);
  }

  .hero-inner {
    text-align: center;
  }

  .eyebrow,
  .note figcaption,
  .tag {
    font: 600 11px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .eyebrow {
    color: var(--brass);
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(34px, 4.6vw, 60px);
    max-width: 28ch;
    margin: 0 auto 24px;
    text-wrap: balance;
  }

  .lead {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    max-width: 640px;
    margin: 0 auto;
  }

  .section-head {
    max-width: 760px;
    margin-bottom: 44px;
  }

  .section-head h2 {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.08;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    line-height: 1.55;
    max-width: 640px;
    margin-top: 18px;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin-bottom: 10px;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.5);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: center;
  }

  .steps {
    list-style: none;
    display: grid;
    gap: 26px;
  }

  .steps li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 18px;
  }

  /* A channel buoy, as on the homepage's Playbooks route. */
  .num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--brass);
    font: 600 13px var(--font-mono);
    color: var(--ink);
  }

  .steps h3 {
    font-size: 21px;
    margin-bottom: 6px;
  }

  .steps p {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .note {
    overflow: hidden;
    border: 1px solid var(--navy-700);
    border-radius: var(--radius);
    background: var(--navy-900);
    box-shadow: 0 18px 40px -22px rgba(6, 18, 32, 0.6);
  }

  .note figcaption {
    padding: 12px 20px;
    border-bottom: 1px solid var(--line);
    color: var(--foam-dim);
  }

  .note-body {
    padding: 18px 20px 22px;
    font: 13.5px/1.75 var(--font-mono);
    color: var(--foam-muted);
  }

  .note-head {
    color: var(--brass);
  }

  .note dl div {
    display: grid;
    grid-template-columns: 13ch minmax(0, 1fr);
  }

  .note dt {
    color: var(--msg-reply);
    font-weight: 600;
  }

  .use b {
    color: var(--fg);
    font-weight: 600;
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .way {
    padding: 14px 14px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgba(6, 18, 32, 0.4);
  }

  .way h3,
  .way p {
    margin-left: 12px;
    margin-right: 12px;
  }

  .way p {
    color: var(--foam-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  /* A slip of chart paper on the water, so the boats keep their paper colors. */
  .way-stage {
    padding: 18px 24px 8px;
    margin-bottom: 22px;
    border-radius: var(--radius-sm);
    background: var(--canvas);
  }

  .way-stage svg {
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .agent {
    --ink: #12202f;
    --hull: #fbf7ee;
    --sail-l: #e5ddc8;
    --sail-r: #fbf7ee;
    --pennant: var(--msg-reply);
    --pennant-fill: var(--pennant);
  }

  .b1 { --bob-dur: 5.2s; --bob-delay: -1s; }
  .b3 { --bob-dur: 5.8s; --bob-delay: -3s; }
  .barge-bob { --bob-dur: 6.4s; --bob-delay: -1.7s; }

  .water {
    fill: none;
    stroke: var(--sea);
    stroke-opacity: 0.45;
    stroke-width: 1.2;
  }

  /* One-way, as the scenes below draw a direct route. */
  .tie {
    fill: none;
    stroke: var(--ink-dim);
    stroke-opacity: 0.7;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .modes {
    display: grid;
    gap: 18px;
  }

  .mode {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 24px 48px;
    align-items: start;
    padding: 28px;
  }

  .mode-copy p {
    color: var(--fg-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: var(--fg-dim);
  }

  .tag i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--brass);
  }

  /* As tall as the copy beside it, and set in the same size. */
  .use {
    display: flex;
    align-items: center;
    align-self: stretch;
    font-size: 16px;
    line-height: 1.6;
    padding: 16px 20px;
    border-left: 3px solid var(--brass);
    background: rgba(201, 162, 77, 0.1);
    border-radius: 0 8px 8px 0;
    color: var(--fg-muted);
  }

  .mode-stage {
    grid-column: 1 / -1;
  }

  /* The way in, as the homepage closes on its download. */
  .start {
    padding: 112px 0 120px;
    background:
      radial-gradient(ellipse 60% 50% at 50% 100%, rgba(201, 162, 77, 0.12), transparent 70%),
      var(--navy-950);
  }

  .start-inner {
    display: grid;
    gap: 44px;
  }

  .start-head {
    margin-bottom: 0;
  }

  .start-steps {
    max-width: 680px;
  }

  .start-steps p b {
    color: var(--fg);
    font-weight: 600;
  }

  .start-note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--fg-dim);
  }

  .start-note a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(223, 233, 238, 0.3);
    text-underline-offset: 3px;
  }

  .start-note a:hover {
    color: var(--fg);
  }

  @media (max-width: 820px) {
    section {
      padding: 72px 0;
    }

    .hero {
      padding: 72px 0 64px;
    }

    .start {
      padding: 72px 0 80px;
    }

    .start-inner {
      gap: 32px;
    }

    .why,
    .ways,
    .mode {
      grid-template-columns: 1fr;
    }

    .mode {
      padding: 20px 16px 14px;
    }

    .why {
      gap: 36px;
    }

    .note dl div {
      grid-template-columns: 1fr;
      margin-top: 8px;
    }
  }
</style>
